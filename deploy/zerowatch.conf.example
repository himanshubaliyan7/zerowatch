# Rename to <host>.conf, set server_name to <subdomain>.vm.internal, symlink into /etc/nginx/conf.d/
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen 80;
    server_name zerowatch-CHANGEME.vm.internal;
    add_header Cache-Control "max-age=0, s-maxage=60";
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_x_original_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_http_version 1.1;
        proxy_buffering off;              # SSE live tail
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
